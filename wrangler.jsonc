{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "test2-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0d3083af-ea12-4c68-b15b-d725d7cef39f","database_name": "test-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9542819fc49949cca1d0205170ba24d7" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
